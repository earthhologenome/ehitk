    orcid: "https://orcid.org/0000-0002-2875-6446"
license: "GPL-3.0-only"
repository-code: "https://github.com/earthhologenome/ehitk"
url: "https://ehitk.readthedocs.io/"
keywords:
  - bioinformatics
  - hologenome
  - metagenomics
  - metadata
  - microbiome
  - command-line-tool
